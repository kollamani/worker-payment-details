# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB - local or Atlas connection string)

MONGODB_USERNAME="your_atlas_username"
MONGODB_PASSWORD="your_atlas_password"
MONGODB_URI="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.example.mongodb.net/financial-ledger?retryWrites=true&w=majority"

# Auth
# REQUIRED (>=32 chars). The server REFUSES TO START without a real secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS - the URL your React frontend runs on
CLIENT_URL=http://localhost:5173

# Optional: allow one-time admin signup only if no admin exists yet (true/false)
RESTRICT_SIGNUP_TO_FIRST_ADMIN=true

# Optional: require this code on the signup form (timing-safe check).
# Leave unset to disable. Generate a random value, e.g. invite codes.
# INVITE_CODE=

# Rate limits (requests per window; defaults shown)
# API_RATE_LIMIT_MAX=300        # per minute, all /api routes
# AUTH_RATE_LIMIT_MAX=10        # per 15 minutes, POST /api/auth/login
# SIGNUP_RATE_LIMIT_MAX=5       # per hour, POST /api/auth/signup

# ---------------------------------------------------------------------------
# Security headers - see docs/SECURITY-HEADERS.md
# All of these are OPTIONAL: the defaults in middleware/securityHeaders.js are
# the hardened ones. Uncomment only to change them.
#
# CSP_MODE:            enforce (default) | report-only | off
# CSP_REPORT_URI:      e.g. https://csp.example.test/collect  (enables report-uri)
# CSP_NONCE:           true only when Express itself renders the HTML shell
# HSTS_ENABLED:        default = (NODE_ENV === production); sent over HTTPS only
# HSTS_MAX_AGE:        default 63072000 (2y); values < 31536000 are clamped up
# HSTS_INCLUDE_SUBDOMAINS: default true
# HSTS_PRELOAD:        default false - read the prerequisites before enabling
# API_CORP:            cross-origin (default) | same-site | same-origin
# API_CACHE_CONTROL:   default "no-store, no-cache, must-revalidate, private"
# SPA_CONNECT_SRC:     extra origins allowed by the SPA connect-src CSP
# TRUST_PROXY_HOPS:    1 (default) - reverse proxies in front of Express
# JSON_BODY_LIMIT:     100kb (default) - request body ceiling
# ---------------------------------------------------------------------------
